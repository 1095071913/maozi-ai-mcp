{
  "name": "redis-mcp-server",
  "version": "1.0.0",
  "description": "Local Redis MCP server (stdio): every Redis command, with read/write separation and key scanning",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "check": "npm run build && node dist/index.js --check",
    "test:e2e": "npm run build && node test/e2e.mjs"
  },
  "dependencies": {
    "@ioredis/commands": "^2.4.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ioredis": "^6.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
