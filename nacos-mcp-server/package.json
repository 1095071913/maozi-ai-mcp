{
  "name": "nacos-mcp-server",
  "version": "1.0.0",
  "description": "Local Nacos MCP server (stdio): namespaces, services, instances, configurations, and every other Nacos API",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "check": "npm run build && node dist/index.js --check",
    "test:e2e": "npm run build && node test/e2e.mjs",
    "test:derby": "npm run build && node test/derby.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
